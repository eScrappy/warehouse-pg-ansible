# {{ ansible_managed }}

global:
  # How long to wait before declaring an alert resolved if no new alerts arrive
  resolve_timeout: {{ alertmanager_resolve_timeout }}
{% if alertmanager_slack_api_url %}
  slack_api_url: '{{ alertmanager_slack_api_url }}'
{% endif %}
{% if alertmanager_pagerduty_url %}
  pagerduty_url: '{{ alertmanager_pagerduty_url }}'
{% endif %}

route:
  group_by: {{ alertmanager_route_group_by | to_yaml | trim }}
  group_wait: {{ alertmanager_route_group_wait }}
  group_interval: {{ alertmanager_route_group_interval }}
  repeat_interval: {{ alertmanager_route_repeat_interval }}
  receiver: '{{ alertmanager_route_receiver }}'
{% if alertmanager_routes %}
  routes:
{{ alertmanager_routes | to_nice_yaml(indent=2) | indent(4, first=true) }}
{% endif %}

receivers:
{{ alertmanager_receivers | to_nice_yaml(indent=2) | indent(2, first=true) }}
{% if alertmanager_inhibit_rules %}

inhibit_rules:
{{ alertmanager_inhibit_rules | to_nice_yaml(indent=2) | indent(2, first=true) }}
{% endif %}
