# {{ ansible_managed }}
[Unit]
Description=Loki Log Aggregation System
Documentation=https://grafana.com/docs/loki/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ loki_user }}
Group={{ loki_group }}
ExecStart={{ loki_install_dir }}/loki -config.file={{ loki_config_dir }}/loki-config.yml
Restart=on-failure

[Install]
WantedBy=multi-user.target
