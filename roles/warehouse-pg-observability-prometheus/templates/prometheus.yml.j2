# {{ ansible_managed }}

global:
  scrape_interval:     {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:{{ prometheus_alertmanager_port }}']

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:{{ prometheus_port }}']

  - job_name: 'wem'
    static_configs:
      - targets: ['localhost:{{ prometheus_wem_port }}']
    metrics_path: '/prom/metrics'
