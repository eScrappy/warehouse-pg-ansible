# {{ ansible_managed }}
[Unit]
Description=Temporal Service
Documentation=https://docs.temporal.io
After=network.target

[Service]
User={{ temporal_user }}
Group={{ temporal_group }}
ExecStart={{ temporal_bin_dir }}/temporal-server -r / -c {{ temporal_config_dir }} -e {{ temporal_config_env }} start
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=temporal

[Install]
WantedBy=multi-user.target
