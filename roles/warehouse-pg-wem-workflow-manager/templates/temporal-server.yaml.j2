# {{ ansible_managed }}
# Temporal.io server configuration — single-node deployment with PostgreSQL persistence.

log:
  stdout: true
  level: info

persistence:
  numHistoryShards: {{ temporal_num_history_shards }}
  defaultStore: default
  visibilityStore: visibility
  datastores:
    default:
      sql:
        pluginName: "{{ temporal_db_plugin }}"
        databaseName: "{{ temporal_db_name }}"
        connectAddr: "{{ temporal_db_host }}:{{ temporal_db_port }}"
        connectProtocol: "tcp"
        user: "{{ temporal_db_user }}"
{% if temporal_db_password | default('') | length > 0 %}
        password: "{{ temporal_db_password }}"
{% else %}
        # password: ""   # uncomment and set if not using trust auth in pg_hba.conf for 127.0.0.1/32
{% endif %}
        maxConns: 20
        maxIdleConns: 20
        maxConnLifetime: "1h"
    visibility:
      sql:
        pluginName: "{{ temporal_db_plugin }}"
        databaseName: "{{ temporal_visibility_db_name }}"
        connectAddr: "{{ temporal_db_host }}:{{ temporal_db_port }}"
        connectProtocol: "tcp"
        user: "{{ temporal_db_user }}"
{% if temporal_db_password | default('') | length > 0 %}
        password: "{{ temporal_db_password }}"
{% else %}
        # password: ""   # uncomment and set if not using trust auth in pg_hba.conf for 127.0.0.1/32
{% endif %}
        maxConns: 10
        maxIdleConns: 10
        maxConnLifetime: "1h"

global:
  membership:
    maxJoinDuration: 120s
    broadcastAddress: "{{ ansible_facts['default_ipv4']['address'] }}"
  pprof:
    port: {{ temporal_pprof_port }}

services:
  frontend:
    rpc:
      grpcPort: {{ temporal_frontend_grpc_port }}
      membershipPort: {{ temporal_frontend_membership_port }}
      bindOnIP: "{{ temporal_bind_ip }}"
  history:
    rpc:
      grpcPort: {{ temporal_history_grpc_port }}
      membershipPort: {{ temporal_history_membership_port }}
      bindOnIP: "{{ temporal_bind_ip }}"
  matching:
    rpc:
      grpcPort: {{ temporal_matching_grpc_port }}
      membershipPort: {{ temporal_matching_membership_port }}
      bindOnIP: "{{ temporal_bind_ip }}"
  worker:
    rpc:
      grpcPort: {{ temporal_worker_grpc_port }}
      membershipPort: {{ temporal_worker_membership_port }}
      bindOnIP: "{{ temporal_bind_ip }}"

clusterMetadata:
  enableGlobalNamespace: false
  failoverVersionIncrement: 10
  masterClusterName: "active"
  currentClusterName: "active"
  clusterInformation:
    active:
      enabled: true
      initialFailoverVersion: 1
      rpcName: "frontend"
      rpcAddress: "{{ ansible_facts['default_ipv4']['address'] }}:{{ temporal_frontend_grpc_port }}"

dcRedirectionPolicy:
  policy: "noop"

archival:
  history:
    state: "disabled"
  visibility:
    state: "disabled"

namespaceDefaults:
  archival:
    history:
      state: "disabled"
    visibility:
      state: "disabled"
